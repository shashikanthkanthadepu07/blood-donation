{
  "name": "blood-donation-system",
  "version": "1.0.0",
  "description": "Full Stack MERN Blood Donation & Bank Management System ready for Vercel deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm run build --prefix client",
    "test": "node test-e2e.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "vercel-build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.x"
  }
}
