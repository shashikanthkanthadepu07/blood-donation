# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/blood_donation_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://demo:demo123@cluster0.mongodb.net/blood_donation?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=lifeflow_super_secret_jwt_key_2026_change_in_production

# Server Port (Local dev)
PORT=5000

# Client URL (for CORS during local testing)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
